# --- Transcription (required) ---------------------------------------------------------------
# Get a key at https://supadata.ai (free tier available).
SUPADATA_API_KEY=

# native   = only use YouTube's existing captions (cheapest; videos without captions are skipped)
# auto     = use captions when they exist, otherwise AI speech-to-text (recommended)
# generate = always use AI speech-to-text
TRANSCRIPT_MODE=auto

# Preferred transcript language (ISO 639-1, e.g. "en"). Leave empty for each video's original language.
TRANSCRIPT_LANG=

# Set to "mock" to try the app with generated fake data and no API key.
TRANSCRIPT_PROVIDER=supadata

# --- Channel listing (optional) -------------------------------------------------------------
# With a free YouTube Data API v3 key, channel listing and video titles/dates come from Google
# instead of using Supadata credits. https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Server ---------------------------------------------------------------------------------
PORT=3000
# SQLite database file. Back this file up (or mount it as a volume) — it holds all transcripts.
DATABASE_PATH=data/transcripter.db

# --- Queue tuning ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
REQUESTS_PER_SECOND=1
MAX_ATTEMPTS=5
# Re-check every channel for new uploads this often (0 = only when you click "Sync now").
SYNC_INTERVAL_HOURS=12
MAX_VIDEOS_PER_CHANNEL=5000
