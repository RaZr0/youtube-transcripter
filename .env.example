# Copy to .env and adjust. Every setting is optional.

# --- Which transcription backend -------------------------------------------------------------
# local    = FREE: YouTube captions via yt-dlp, plus Whisper on this computer for videos without
#            captions. Run `npm run setup:local` once to install yt-dlp + faster-whisper.
# supadata = paid API (needs SUPADATA_API_KEY), no YouTube blocking to worry about
# mock     = generated fake data, for trying out the UI
# Default: supadata if SUPADATA_API_KEY is set, otherwise local.
TRANSCRIPT_PROVIDER=local

# Preferred transcript language (ISO 639-1, e.g. "en"). Empty = each video's original language.
TRANSCRIPT_LANG=

# --- Free local mode --------------------------------------------------------------------------
# Average pause between videos (randomised ±30%). Slower = less likely to be blocked by YouTube.
YOUTUBE_REQUEST_DELAY_SECONDS=8
# If YouTube blocks anyway, pause everything this long and then resume automatically.
YOUTUBE_BLOCK_PAUSE_MINUTES=60
# Whisper for videos without captions. Model "auto" = large-v3-turbo with an NVIDIA GPU, small on CPU.
# Others: tiny, base, small, medium, large-v3, large-v3-turbo (bigger = more accurate, slower).
WHISPER_ENABLED=true
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
# Keep yt-dlp up to date automatically (YouTube changes often break old versions).
YTDLP_AUTO_UPDATE=true
# Optional: cookies.txt exported from a browser logged into a SPARE Google account. Helps with
# blocking and age-restricted videos, but ties the activity to that account.
YTDLP_COOKIES_FILE=
# Only needed if you installed the tools yourself instead of `npm run setup:local`:
# YTDLP_PATH=yt-dlp
# WHISPER_PYTHON=python3

# --- Paid mode (Supadata) ---------------------------------------------------------------------
SUPADATA_API_KEY=
# native = only existing captions (1 credit/video), auto = captions or AI fallback (AI costs
# 1 credit per minute), generate = always AI
TRANSCRIPT_MODE=auto
REQUESTS_PER_SECOND=1

# --- Optional, both modes ---------------------------------------------------------------------
# Free YouTube Data API v3 key: more reliable channel listing.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Server & queue ---------------------------------------------------------------------------
PORT=3000
# SQLite database file. Back this file up — it holds all transcripts.
DATABASE_PATH=data/transcripter.db
WORKER_CONCURRENCY=2
MAX_ATTEMPTS=5
# Re-check every channel for new uploads this often (0 = only when you click "Sync now").
SYNC_INTERVAL_HOURS=12
MAX_VIDEOS_PER_CHANNEL=5000
